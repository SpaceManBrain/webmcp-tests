{
  "name": "dmf-webmcp-tests",
  "version": "1.0.0",
  "description": "E2E test agent for DMF WebMCP tools — 29 tools across dmfam.org and app.dmfam.org",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:site": "playwright test specs/site-dmfam.spec.ts",
    "test:app": "playwright test specs/app-t0-t1.spec.ts specs/app-t3-safety.spec.ts specs/app-swap-flow.spec.ts",
    "test:safety": "playwright test specs/app-t3-safety.spec.ts",
    "test:headed": "DMF_TEST_HEADLESS=false playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "typescript": "^5.7.0"
  }
}
